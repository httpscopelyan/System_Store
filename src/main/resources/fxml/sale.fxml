<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="sale-root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.scopel.pfv.beta.controller.SaleController">


    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="inicio-root">
        <VBox minHeight="560" spacing="8">
            <padding>
                <Insets bottom="10" left="24" right="24" top="10" />
            </padding>

            <HBox alignment="BOTTOM_LEFT" spacing="0">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="code-label" text="Código ou nome do produto" />
                    <TextField fx:id="codeField" maxWidth="Infinity" onAction="#onAddItem" promptText="Bipe, digite o código ou o nome" styleClass="code-field, code-field-left" />
                </VBox>
                <VBox minWidth="230" prefWidth="230" spacing="6">
                    <Label fx:id="quantityLabel" styleClass="code-label" text="Qtd" />
                    <TextField fx:id="quantityField" onAction="#onQuantityEntered" promptText="Qtd" styleClass="code-field, code-field-right" />
                </VBox>
            </HBox>
            <Label fx:id="quantityPreviewLabel" maxWidth="Infinity" styleClass="quantity-preview" />

            <VBox fx:id="lastItemDisplay" focusTraversable="false" maxWidth="Infinity" styleClass="last-item-display">
                <Label fx:id="lastItemLabel" focusTraversable="false" maxWidth="Infinity" styleClass="last-item-name" text="—" wrapText="true" />
            </VBox>

            <TableView fx:id="itemsTable" minHeight="180" prefHeight="300" styleClass="items-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="descriptionCol" prefWidth="520.0" text="Descrição" />
                    <TableColumn fx:id="quantityCol" prefWidth="140.0" text="Qtd" />
                    <TableColumn fx:id="unitPriceCol" prefWidth="200.0" text="Preço" />
                    <TableColumn fx:id="totalPriceCol" prefWidth="240.0" text="Total" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Label fx:id="statusLabel" styleClass="sale-status" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="discountField" prefWidth="130" promptText="Desconto R$ (F5)" />
                <Button onAction="#onApplyDiscount" styleClass="success-button, compact-button" text="Aplicar desconto" />
                <TextField fx:id="customerIdField" prefWidth="120" promptText="Cliente ID (F9)" />
                <Button onAction="#onSetCustomer" styleClass="success-button, compact-button" text="Vincular cliente" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onCancelItem" styleClass="danger-button, compact-button" text="Cancelar item" />
                <Button onAction="#onCancelSale" styleClass="danger-button, compact-button" text="Cancelar venda" />
            </HBox>
        </VBox>
        </ScrollPane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" prefWidth="380.0" spacing="16">
            <padding>
                <Insets bottom="18" left="0" right="24" top="18" />
            </padding>

            <VBox maxWidth="Infinity" spacing="4" styleClass="total-panel">
                <Label styleClass="total-caption" text="TOTAL" />
                <Label fx:id="totalLabel" styleClass="total-value" text="R$ 0,00" />
            </VBox>

            <Button maxWidth="Infinity" onAction="#onFinalize" styleClass="finalize-button" text="Finalizar Venda (F10)" />

            <VBox maxWidth="Infinity" spacing="6" VBox.vgrow="ALWAYS">
                <Label styleClass="form-section-title" text="Prévia do cupom — NÃO É DOCUMENTO FISCAL" />
                <TextArea fx:id="receiptPreview" editable="false" focusTraversable="false" maxWidth="Infinity" styleClass="receipt-preview" wrapText="false" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="sale-footer">
            <Label styleClass="key-hint" text="Enter" />
            <Label text="Adicionar item" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F1" />
            <Label text="Preço" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F5" />
            <Label text="Desconto" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F6" />
            <Label text="Cancelar item" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F7" />
            <Label text="Cancelar venda" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F9" />
            <Label text="Cliente" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F10" />
            <Label text="Finalizar" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F11" />
            <Label text="Tela cheia" />
            <Region prefWidth="6" />
            <Label styleClass="key-hint" text="F12" />
            <Label text="Gaveta" />
            <Region prefWidth="6" />
        </HBox>
    </bottom>

</BorderPane>
