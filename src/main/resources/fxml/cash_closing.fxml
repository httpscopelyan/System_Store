<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.scopel.pfv.beta.controller.CashClosingController"
      styleClass="group-box" spacing="6" prefWidth="270">
    <padding><Insets top="10" right="12" bottom="12" left="12"/></padding>
    <Label text="Conferência do Fechamento" styleClass="group-title"/>
    <HBox spacing="6">
        <Label text="Esperado" styleClass="win-label-bold" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label text="Contado" styleClass="win-label-bold" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <Label text="Dinheiro" styleClass="win-label"/>
    <HBox spacing="6">
        <TextField fx:id="expCash" text="R$ 0,00" editable="false" styleClass="money-field" HBox.hgrow="ALWAYS" prefWidth="110"/>
        <TextField fx:id="cntCash" promptText="Contado" styleClass="win-input" HBox.hgrow="ALWAYS" prefWidth="110"/>
    </HBox>
    <Label fx:id="difCash" styleClass="win-label"/>

    <Label text="PIX / QR Code" styleClass="win-label"/>
    <HBox spacing="6">
        <TextField fx:id="expPix" text="R$ 0,00" editable="false" styleClass="money-field" HBox.hgrow="ALWAYS" prefWidth="110"/>
        <TextField fx:id="cntPix" promptText="Contado" styleClass="win-input" HBox.hgrow="ALWAYS" prefWidth="110"/>
    </HBox>
    <Label fx:id="difPix" styleClass="win-label"/>

    <Label text="Cartão de Crédito" styleClass="win-label"/>
    <HBox spacing="6">
        <TextField fx:id="expCredit" text="R$ 0,00" editable="false" styleClass="money-field" HBox.hgrow="ALWAYS" prefWidth="110"/>
        <TextField fx:id="cntCredit" promptText="Contado" styleClass="win-input" HBox.hgrow="ALWAYS" prefWidth="110"/>
    </HBox>
    <Label fx:id="difCredit" styleClass="win-label"/>

    <Label text="Cartão de Débito" styleClass="win-label"/>
    <HBox spacing="6">
        <TextField fx:id="expDebit" text="R$ 0,00" editable="false" styleClass="money-field" HBox.hgrow="ALWAYS" prefWidth="110"/>
        <TextField fx:id="cntDebit" promptText="Contado" styleClass="win-input" HBox.hgrow="ALWAYS" prefWidth="110"/>
    </HBox>
    <Label fx:id="difDebit" styleClass="win-label"/>

    <Label fx:id="totalDifferenceLabel" styleClass="win-label-bold" wrapText="true"/>
    <Button fx:id="closeButton" text="🔒 Fechar Caixa" onAction="#onClose" styleClass="win-button-primary"
            maxWidth="Infinity"/>
</VBox>
