<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.StockEntryController"
            stylesheets="@../css/styles.css" styleClass="inicio-root">
    <top>
        <VBox styleClass="page-header">
            <Label text="Estoque — Entrada de mercadoria" styleClass="page-header-title"/>
            <Label text="Soma ao estoque e atualiza o custo" styleClass="page-header-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="18">
            <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
            <VBox styleClass="form-card" spacing="14" maxWidth="Infinity">
                <VBox spacing="6">
                    <Label text="Código do produto" styleClass="form-label"/>
                    <TextField fx:id="codeField" promptText="Código de barras" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Quantidade" styleClass="form-label"/>
                        <TextField fx:id="quantityField" promptText="Ex: 10" styleClass="text-input" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Custo unitário (opcional)" styleClass="form-label"/>
                        <TextField fx:id="unitCostField" promptText="Ex: 4.50" styleClass="text-input" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Motivo / Observação" styleClass="form-label"/>
                    <TextField fx:id="reasonField" promptText="Ex: Nota 123" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button onAction="#onSave" text="Registrar entrada" styleClass="success-button"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
