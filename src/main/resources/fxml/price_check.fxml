<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.PriceCheckController"
            stylesheets="@../css/styles.css"
            styleClass="sale-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Consulta de Preço — Mercado Maná" styleClass="page-header-title"/>
            <Label text="Consulta rápida (F1) — não registra venda" styleClass="page-header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="SÓ CONSULTA — NÃO É VENDA" styleClass="price-check-warning" maxWidth="Infinity"/>

            <HBox spacing="16">
                <VBox spacing="6" prefWidth="320">
                    <Label text="Código de barras" styleClass="code-label"/>
                    <TextField fx:id="codeField" promptText="Bipe ou digite o código"
                               styleClass="code-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Nome do produto" styleClass="code-label"/>
                    <TextField fx:id="nameField" promptText="Ex: red, monster, pão..."
                               styleClass="code-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <TableView fx:id="resultsTable" styleClass="items-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCode" text="Código" prefWidth="170"/>
                    <TableColumn fx:id="colName" text="Nome" prefWidth="520"/>
                    <TableColumn fx:id="colPrice" text="Preço" prefWidth="220"/>
                    <TableColumn fx:id="colStock" text="Quantidade" prefWidth="170"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="statusLabel" styleClass="sale-status"/>

            <Button text="Voltar (Esc)" onAction="#onBack" styleClass="secondary-button"/>
        </VBox>
    </center>

</BorderPane>
