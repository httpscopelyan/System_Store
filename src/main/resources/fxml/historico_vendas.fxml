<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.HistoricoVendasController"
            stylesheets="@../css/styles.css"
            styleClass="sale-root">

    <top>
        <VBox styleClass="page-header">
            <Label text="Histórico de Vendas — Mercado Scopel" styleClass="page-header-title"/>
            <Label text="Vendas finalizadas (mais recentes primeiro)" styleClass="page-header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <TableView fx:id="table" styleClass="items-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" prefWidth="200.0" text="Data/Hora"/>
                    <TableColumn fx:id="colId" prefWidth="120.0" text="Venda #"/>
                    <TableColumn fx:id="colOperator" prefWidth="260.0" text="Operador"/>
                    <TableColumn fx:id="colCustomer" prefWidth="320.0" text="Cliente"/>
                    <TableColumn fx:id="colTotal" prefWidth="200.0" text="Total"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="statusLabel" styleClass="sale-status"/>
        </VBox>
    </center>

</BorderPane>
