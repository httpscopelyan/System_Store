<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.PayableListController"
            stylesheets="@../css/styles.css" styleClass="inicio-root">
    <top>
        <VBox styleClass="page-header">
            <Label text="Contas a Pagar" styleClass="page-header-title"/>
            <Label text="Lançamento e baixa de contas" styleClass="page-header-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>

            <VBox styleClass="form-card" spacing="10">
                <Label text="Nova conta" styleClass="form-section-title"/>
                <HBox spacing="12">
                    <TextField fx:id="descField" promptText="Descrição" styleClass="text-input" HBox.hgrow="ALWAYS"/>
                    <DatePicker fx:id="dueField"/>
                    <TextField fx:id="amountField" promptText="Valor" styleClass="text-input"/>
                    <Button text="Adicionar" onAction="#onAdd" styleClass="success-button"/>
                </HBox>
            </VBox>

            <TableView fx:id="table" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colDesc" text="Descrição" prefWidth="260"/>
                    <TableColumn fx:id="colDue" text="Vencimento" prefWidth="120"/>
                    <TableColumn fx:id="colAmount" text="Valor" prefWidth="100"/>
                    <TableColumn fx:id="colRemaining" text="Saldo" prefWidth="100"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="payField" promptText="Valor a pagar" styleClass="text-input"/>
                <Button text="Pagar selecionada" onAction="#onPay" styleClass="success-button"/>
                <Button text="Atualizar" onAction="#onRefresh"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
