<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.MyAccountController"
            stylesheets="@../css/styles.css" styleClass="inicio-root">
    <top>
        <VBox styleClass="page-header">
            <Label text="Minha conta" styleClass="page-header-title"/>
            <Label text="Altere seu nome de acesso e sua senha" styleClass="page-header-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="18">
            <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
            <VBox styleClass="form-card" spacing="12" maxWidth="520">
                <Label text="O nome definido aqui é o usado para entrar no sistema." styleClass="form-label" wrapText="true"/>
                <VBox spacing="6">
                    <Label text="Nome (usado para entrar)" styleClass="form-label"/>
                    <TextField fx:id="nameField"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Senha nova (deixe em branco para manter)" styleClass="form-label"/>
                    <PasswordField fx:id="newPasswordField"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Confirmar senha nova" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Senha atual (obrigatória para salvar)" styleClass="form-label"/>
                    <PasswordField fx:id="currentPasswordField" onAction="#onSave"/>
                </VBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button onAction="#onSave" text="Salvar" styleClass="success-button"/>
                </HBox>
                <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
    <bottom>
        <fx:include source="back_bar.fxml"/>
    </bottom>
</BorderPane>
