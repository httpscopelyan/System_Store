<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" prefHeight="720" prefWidth="1365" styleClass="app-shell" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.scopel.pfv.beta.controller.MainController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-bar">
                <padding><Insets bottom="6" left="14" right="14" top="6" /></padding>
                <Label styleClass="brand-bar-title" text="SCOPEL STORE" />
            </HBox>
            <TilePane fx:id="blocksBar" hgap="6" prefColumns="9" styleClass="top-bar" tileAlignment="CENTER" vgap="6">
                <Button fx:id="backButton" disable="true" onAction="#onBack" styleClass="block-button" text="◀&#10;Voltar&#10;V" />
                <Button onAction="#onConsultaPreco" styleClass="block-button" text="🏷&#10;Preço&#10;F1" />
                <Button onAction="#onVender" styleClass="block-button, block-primary" text="🛒&#10;Nova Venda&#10;F2" />
                <Button onAction="#onNavigate" styleClass="block-button" text="🧮&#10;Cobrar" userData="COBRAR" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="📜&#10;Histórico" userData="HISTORICO_VENDAS" />
                <Button onAction="#onNavigate" styleClass="block-button" text="💰&#10;Caixa&#10;F4" userData="CAIXA" />
                <Button onAction="#onNavigate" styleClass="block-button" text="📦&#10;Estoque&#10;F3" userData="ESTOQUE" />
                <Button fx:id="shoppingListButton" onAction="#onNavigate" styleClass="block-button, block-extra" text="🧺&#10;Lista d/ Compras" userData="LISTA_COMPRAS" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="🧾&#10;Compras&#10;F5" userData="COMPRAS" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="👥&#10;Clientes&#10;F6" userData="CLIENTES" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="🚚&#10;Fornecedores&#10;F7" userData="FORNECEDORES" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="📝&#10;Orçamentos" userData="ORCAMENTO" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="＄&#10;A Receber" userData="CONTAS_RECEBER" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="＄&#10;A Pagar" userData="CONTAS_PAGAR" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="🏷&#10;Preços" userData="TABELAS_PRECO" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="📊&#10;Relatórios&#10;F8" userData="RELATORIOS" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="👤&#10;Minha conta" userData="MINHA_CONTA" />
                <Button onAction="#onNavigate" styleClass="block-button, block-extra" text="🔁&#10;Trocar de conta" userData="TROCAR_CONTA" />
                <Button fx:id="adminButton" onAction="#onNavigate" styleClass="block-button, block-extra" text="🛡&#10;Administração" userData="ADMIN" />
                <Button fx:id="configButton" onAction="#onNavigate" styleClass="block-button, block-extra" text="⚙&#10;Config" userData="CONFIG" />
                <Button fx:id="moreButton" onAction="#onToggleMore" styleClass="block-button" text="»&#10;Mais" />
            </TilePane>
        </VBox>
    </top>

    <center>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="status-bar">
            <padding>
                <Insets bottom="4" left="12" right="12" top="4" />
            </padding>
            <Label fx:id="dateTimeLabel" text="" />
            <Label fx:id="userLabel" text="Usuário: -" />
            <Label fx:id="roleLabel" text="Grupo: -" />
            <Label fx:id="caixaStatusLabel" text="Caixa fechado" />
            <Label text="Empresa: Mercado Maná" />
            <Label fx:id="terminalLabel" text="Terminal: CAIXA 01" />
            <Label fx:id="hintLabel" styleClass="status-hint" text="" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="updateButton" managed="false" onAction="#onUpdateAndRestart" styleClass="update-button" visible="false" />
        </HBox>
    </bottom>

</BorderPane>
