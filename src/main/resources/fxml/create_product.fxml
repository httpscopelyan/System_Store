<?xml version="1.0" encoding="UTF-8"?>

<?import com.sun.javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="356.0" prefWidth="415.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.scopel.pfv.beta.controller.CreateProductsController">
    <Label text="Tela de Cadastro">
      <VBox.margin>
         <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
      </VBox.margin></Label>

    <Label text="Código do produto">
        <VBox.margin>
            <Insets top="2.0" />
        </VBox.margin>
    </Label>
    <TextField fx:id="codeField">
      <VBox.margin>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </VBox.margin></TextField>

    <Label text="Nome do Produto">
        <VBox.margin>
            <Insets top="2.0" />
        </VBox.margin>
    </Label>
    <TextField fx:id="descriptionField" prefWidth="150.0">
      <VBox.margin>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </VBox.margin></TextField>

    <Label text="Preço">
        <VBox.margin>
            <Insets top="2.0" />
        </VBox.margin>
    </Label>
    <TextField fx:id="priceField" prefWidth="150.0">
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </VBox.margin>
    </TextField>

    <Label text="Quantidade">
        <VBox.margin>
            <Insets top="2.0" />
        </VBox.margin>
    </Label>
    <TextField fx:id="quantityField" prefWidth="150.0">
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </VBox.margin>
    </TextField>

    <Label text="Unidade">
        <VBox.margin>
            <Insets bottom="2.0" />
        </VBox.margin>
    </Label>
    <ComboBox fx:id="unitBox" prefWidth="150.0">
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </VBox.margin>
    </ComboBox>

    <Label text="Ativo/Inativo">
        <VBox.margin>
            <Insets bottom="2.0" />
        </VBox.margin>
    </Label>
    <CheckBox fx:id="activeBox">
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </VBox.margin>
    </CheckBox>

    <Button alignment="CENTER" contentDisplay="CENTER" layoutX="50.0" onAction="#onSave" prefHeight="26.0" prefWidth="75.0" text="Salvar" textAlignment="CENTER" />

    <Label fx:id="messageLabel" />

    <VBox.margin>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </VBox.margin>



</VBox>
