<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.PagamentoEsperaController"
            stylesheets="@../css/styles.css"
            styleClass="sale-root"
            onKeyPressed="#onKey">


    <center>
        <VBox spacing="24" alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Cobrança no cartão" styleClass="finalized-caption"/>

            <VBox styleClass="total-panel" spacing="4" maxWidth="Infinity">
                <Label text="TOTAL" styleClass="total-caption"/>
                <Label fx:id="totalLabel" text="R$ 0,00" styleClass="total-value"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Tipo:" styleClass="finalized-caption"/>
                <Label fx:id="typeLabel" text="-" styleClass="finalized-caption"/>
            </HBox>

            <VBox fx:id="manualBox" spacing="8" alignment="CENTER" visible="false" managed="false">
                <Label text="Valor recebido na maquininha" styleClass="finalized-caption"/>
                <TextField fx:id="receivedField" promptText="Ex: 25,90" maxWidth="260"/>
            </VBox>

            <Label fx:id="statusLabel" styleClass="sale-status" wrapText="true"/>

            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="confirmButton" text="Confirmar (ENTER)" onAction="#onConfirm" styleClass="primary-button" defaultButton="true"/>
                <Button text="Cancelar (ESC)" onAction="#onCancel" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
