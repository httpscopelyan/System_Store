<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.StockAdjustController"
            stylesheets="@../css/styles.css" styleClass="inicio-root">
    <top>
        <VBox styleClass="page-header">
            <Label text="Estoque — Ajuste manual" styleClass="page-header-title"/>
            <Label text="Define a quantidade exata com motivo (auditado)" styleClass="page-header-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="18">
            <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
            <VBox styleClass="form-card" spacing="14" maxWidth="Infinity">
                <VBox spacing="6">
                    <Label text="Código do produto" styleClass="form-label"/>
                    <TextField fx:id="codeField" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Nova quantidade (contada)" styleClass="form-label"/>
                    <TextField fx:id="quantityField" promptText="Ex: 12" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Motivo" styleClass="form-label"/>
                    <TextField fx:id="reasonField" promptText="Ex: Contagem de inventário" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button onAction="#onSave" text="Ajustar estoque" styleClass="success-button"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
