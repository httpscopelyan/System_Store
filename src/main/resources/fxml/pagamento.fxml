<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.PaymentController"
            stylesheets="@../css/styles.css"
            styleClass="sale-root"
            onKeyPressed="#onKey">

    <top>
        <VBox styleClass="page-header">
            <Label text="Pagamento — Mercado Scopel" styleClass="page-header-title"/>
            <Label text="Escolha a forma de pagamento" styleClass="page-header-subtitle"/>
        </VBox>
    </top>

    <center>
        <!-- Rola em telas baixas (1366x768) sem roubar o foco do teclado 1/2/3. -->
        <ScrollPane fitToWidth="true" focusTraversable="false">
            <VBox spacing="18" alignment="TOP_CENTER">
                <padding>
                    <Insets top="24" right="40" bottom="24" left="40"/>
                </padding>

                <!-- TOTAL grande -->
                <VBox styleClass="total-panel" spacing="4" maxWidth="Infinity">
                    <Label text="TOTAL A PAGAR" styleClass="total-caption"/>
                    <Label fx:id="totalLabel" text="R$ 0,00" styleClass="total-value"/>
                </VBox>

                <!-- Formas de pagamento -->
                <Button fx:id="dinheiroOption" text="1  —  DINHEIRO" onAction="#onDinheiro"
                        styleClass="pay-option" maxWidth="Infinity"/>
                <Button text="2  —  CARTÃO" onAction="#onCartao"
                        styleClass="pay-option" maxWidth="Infinity"/>
                <Button text="3  —  PIX" onAction="#onPix"
                        styleClass="pay-option" maxWidth="Infinity"/>

                <Label fx:id="statusLabel" styleClass="sale-status"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sale-footer" spacing="8" alignment="CENTER_LEFT">
            <Label text="1" styleClass="key-hint"/>
            <Label text="Dinheiro"/>
            <Label text="2" styleClass="key-hint"/>
            <Label text="Cartão"/>
            <Label text="3" styleClass="key-hint"/>
            <Label text="PIX"/>
            <Label text="   ESC" styleClass="key-hint"/>
            <Label text="Voltar à venda"/>
        </HBox>
    </bottom>

</BorderPane>
