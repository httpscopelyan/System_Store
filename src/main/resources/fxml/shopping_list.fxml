<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.ShoppingListController"
            stylesheets="@../css/styles.css" styleClass="win-root">

    <top>
        <VBox>
            <HBox styleClass="win-titlebar" alignment="CENTER_LEFT">
                <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                <Label text="Lista d/ Compras" styleClass="win-titlebar-text"/>
            </HBox>
            <HBox alignment="CENTER" styleClass="group-box">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Label text="Itens com estoque perto do mínimo" styleClass="estoque-title"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" styleClass="win-grid">
            <columns>
                <TableColumn fx:id="colCode" text="Código" prefWidth="130"/>
                <TableColumn fx:id="colDescription" text="Nome" prefWidth="280"/>
                <TableColumn fx:id="colStock" text="Estoque atual" prefWidth="100"/>
                <TableColumn fx:id="colMinStock" text="Estoque mínimo" prefWidth="110"/>
                <TableColumn fx:id="colDifference" text="Diferença" prefWidth="90"/>
                <TableColumn fx:id="colRestock" text="Repor" prefWidth="90"/>
                <TableColumn fx:id="colStatus" text="Situação" prefWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <HBox spacing="6" styleClass="group-box">
                <padding><Insets top="2" right="12" bottom="2" left="12"/></padding>
                <Label fx:id="messageLabel" styleClass="sale-status" wrapText="true"/>
            </HBox>
            <HBox styleClass="win-footer" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                <Button text="🔄 Atualizar" onAction="#onRefresh" styleClass="success-button"/>
                <Button fx:id="sendButton" text="✉ Enviar por e-mail agora" onAction="#onSendNow" styleClass="win-button"/>
                <Button text="➕ Entrada" onAction="#onEntry" styleClass="win-button"/>
            </HBox>
            <fx:include source="back_bar.fxml"/>
        </VBox>
    </bottom>

</BorderPane>
