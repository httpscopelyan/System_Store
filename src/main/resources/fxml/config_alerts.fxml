<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.scopel.pfv.beta.controller.ConfigAlertsController"
      styleClass="form-card" spacing="12" maxWidth="Infinity">
    <Label text="Avisos de estoque" styleClass="form-section-title"/>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Avisar quando faltar até X do estoque mínimo" styleClass="form-label"/>
            <TextField fx:id="marginField" promptText="Ex: 5" styleClass="text-input" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Intervalo do aviso por e-mail (minutos, mínimo 15)" styleClass="form-label"/>
            <TextField fx:id="intervalField" promptText="1440" styleClass="text-input" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <CheckBox fx:id="emailEnabledBox" text="Enviar a lista de itens para repor por e-mail"/>

    <VBox spacing="6">
        <Label text="E-mails que recebem os avisos (separe por vírgula)" styleClass="form-label"/>
        <TextField fx:id="emailToField" promptText="dono@mercado.com, gerente@mercado.com"
                   styleClass="text-input" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Servidor SMTP" styleClass="form-label"/>
            <TextField fx:id="smtpHostField" promptText="smtp.gmail.com" styleClass="text-input" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Porta" styleClass="form-label"/>
            <TextField fx:id="smtpPortField" promptText="587" styleClass="text-input" prefWidth="90"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Usuário SMTP" styleClass="form-label"/>
            <TextField fx:id="smtpUserField" styleClass="text-input" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Remetente (From)" styleClass="form-label"/>
            <TextField fx:id="smtpFromField" styleClass="text-input" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <Label text="A senha do SMTP fica no arquivo .env (SMTP_PASSWORD) e nunca é gravada no banco."
           styleClass="form-label" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Salvar avisos" onAction="#onSave" styleClass="success-button"/>
        <Button text="Testar envio" onAction="#onTest" styleClass="win-button"/>
    </HBox>
    <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"/>
</VBox>
