<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.scopel.pfv.beta.controller.EstoqueController"
            stylesheets="@../css/styles.css" styleClass="win-root">

    <top>
        <VBox>
            <HBox styleClass="win-titlebar" alignment="CENTER_LEFT">
                <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                <Label text="Controle de Estoque" styleClass="win-titlebar-text"/>
            </HBox>
            <HBox alignment="CENTER" styleClass="group-box">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Label text="Estoque » Visualização" styleClass="estoque-title"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="group-box">
                <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                <Label text="Código:" styleClass="win-label-bold"/>
                <TextField fx:id="codeFilter" promptText="Código de barras" styleClass="win-input" prefWidth="160"/>
                <Label text="Nome:" styleClass="win-label-bold"/>
                <TextField fx:id="nameFilter" promptText="Buscar por descrição" styleClass="win-input" HBox.hgrow="ALWAYS"/>
                <Button text="Filtrar" onAction="#onFilter" styleClass="win-button-primary"/>
                <Button text="Limpar" onAction="#onClear" styleClass="win-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" styleClass="win-grid">
            <columns>
                <TableColumn fx:id="colCode" text="Código" prefWidth="130"/>
                <TableColumn fx:id="colDesc" text="Nome" prefWidth="260"/>
                <TableColumn fx:id="colCost" text="Custo" prefWidth="90"/>
                <TableColumn fx:id="colLucro" text="Lucro (%)" prefWidth="90"/>
                <TableColumn fx:id="colSugest" text="Sugest." prefWidth="90"/>
                <TableColumn fx:id="colPrice" text="Vr. Venda" prefWidth="90"/>
                <TableColumn fx:id="colMin" text="Qtd. Mín." prefWidth="80"/>
                <TableColumn fx:id="colStock" text="Qtd. Atual" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox>
            <HBox spacing="6" styleClass="group-box">
                <padding><Insets top="2" right="12" bottom="2" left="12"/></padding>
                <Label fx:id="messageLabel" styleClass="sale-status" wrapText="true"/>
            </HBox>
            <HBox styleClass="win-footer" spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                <Button text="＋ Novo" onAction="#onNew" styleClass="success-button"/>
                <Button text="✎ Alterar" onAction="#onAlterar" styleClass="win-button"/>
                <Button text="－ Apagar" onAction="#onApagar" styleClass="danger-button"/>
                <Separator orientation="VERTICAL"/>
                <Button text="➕ Entrada" onAction="#onEntrada" styleClass="win-button"/>
                <Button text="⚖ Ajuste" onAction="#onAjuste" styleClass="win-button"/>
                <Button text="📅 Lotes" onAction="#onLotes" styleClass="win-button"/>
                <Button text="🏷 Etiquetas" onAction="#onEtiquetas" styleClass="win-button"/>
                <Button text="🖨 Relatórios" onAction="#onRelatorios" styleClass="win-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 ATUALIZAR" onAction="#onRefresh" styleClass="success-button"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
